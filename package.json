{
  "name": "gins-rules",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "sync": "swift run --package-path tools gins-rules-syncer --root . sync",
    "icons": "swift run --package-path tools gins-rules-syncer --root . icons",
    "compile": "swift run --package-path tools gins-rules-compiler --root .",
    "build": "pnpm sync && pnpm icons && pnpm compile && cd dashboard && pnpm build && cp -r dist/* ../compiled/",
    "deploy": "pnpm build && wrangler deploy --config cmd/scanner/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/darwin-arm64",
      "@esbuild/linux-x64",
      "sharp",
      "workerd",
      "@cloudflare/workerd-darwin-arm64",
      "@cloudflare/workerd-linux-x64"
    ]
  }
}
