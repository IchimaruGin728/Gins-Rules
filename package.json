{
  "name": "gins-rules",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "sync": "cargo run --release --manifest-path tools/Cargo.toml --bin Gins-Rules-Syncer -- --root . sync",
    "icons": "cargo run --release --manifest-path tools/Cargo.toml --bin Gins-Rules-Syncer -- --root . icons",
    "compile": "cargo run --release --manifest-path tools/Cargo.toml --bin Gins-Rules-Compiler -- --root .",
    "build": "pnpm sync && pnpm icons && pnpm compile && cd dashboard && pnpm build && cp -r dist/* ../compiled/",
    "deploy": "pnpm build && wrangler deploy --config cmd/scanner/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
