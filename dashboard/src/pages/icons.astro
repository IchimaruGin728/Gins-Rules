---
import fs from "node:fs";
import path from "node:path";
import Layout from "../components/Layout.astro";
import GinsIcons from "../components/GinsIcons.preact";

/** @type {import("../components/GinsIcons.preact").Icon[]} */
let icons = [];

try {
  const catalogPath = path.join(process.cwd(), "public", "icons-catalog.json");
  if (fs.existsSync(catalogPath)) {
    icons = JSON.parse(fs.readFileSync(catalogPath, "utf-8"));
  }
} catch (e) {
  console.error("Failed to load icons:", e);
}

// Silencing Biome "unused" warnings for Astro templates
void fs;
void path;
void Layout;
void GinsIcons;
void icons;
---

<Layout title="Gins Icon Hub | Premium Proxy Assets">
  <div class="max-w-7xl mx-auto px-6 py-12">
    <GinsIcons client:load initialIcons={icons} />
  </div>
</Layout>
